# Optional: authorized local JSON fallback for official/API-style data
# Format: either a list of comments or dict keyed by shortcode
IG_AUTHORIZED_COMMENTS_FILE=

# Optional future official Instagram Graph API placeholders
IG_ACCESS_TOKEN=
IG_USER_ID=
IG_MEDIA_ID=

# Instagrapi behaviour
INSTAGRAM_REQUEST_AMOUNT=100
INSTAGRAM_DELAY_MIN=2
INSTAGRAM_DELAY_MAX=5

# Optional: force rule-based mode if transformer models are slow/unavailable
COMMENTSENSE_DISABLE_TRANSFORMERS=false